# 必填：OpenAI 兼容的 Chat Completions 接口，地址通常以 /v1 结尾。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=replace-with-your-api-key
MODEL_ID=replace-with-your-model

# 默认读取本项目 workspace 文件夹。可改为现有目录；Windows 路径建议用 /。
WORKSPACE_DIR=./workspace
WEB_PORT=4096
# 可信内网团队访问时可改为 0.0.0.0。
BIND_ADDRESS=127.0.0.1
